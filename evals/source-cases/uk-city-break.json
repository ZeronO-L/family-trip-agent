{
  "case_id": "source-uk-city-break",
  "title": "United Kingdom city trip selects local weather and restaurant providers",
  "input": {
    "country_code": "GB",
    "destination_types": ["city"],
    "needs": ["maps", "reviews", "community", "hotels", "tickets", "weather", "roads"]
  },
  "expected_provider_ids": ["google-maps", "tripadvisor", "opentable", "thefork", "booking-com", "expedia", "met-office", "getyourguide", "tiqets"],
  "prohibited_provider_ids": ["yelp", "nws", "bom"],
  "assertions": {
    "min_providers_per_need": { "maps": 2, "reviews": 3, "hotels": 3, "tickets": 4, "weather": 2, "roads": 2 },
    "require_official_for": ["community", "hotels", "tickets", "weather", "roads"]
  },
  "privacy": { "synthetic_or_anonymized": true }
}
