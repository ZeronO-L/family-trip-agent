{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-trip-agent.local/schemas/source-eval-case.schema.json",
  "title": "Global source routing evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "title", "input", "expected_provider_ids", "prohibited_provider_ids", "assertions", "privacy"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "required": ["country_code", "needs"],
      "properties": {
        "country_code": { "type": "string", "minLength": 2, "maxLength": 2 },
        "destination_types": { "type": "array", "items": { "type": "string" } },
        "needs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expected_provider_ids": { "type": "array", "items": { "type": "string" } },
    "prohibited_provider_ids": { "type": "array", "items": { "type": "string" } },
    "assertions": {
      "type": "object",
      "required": ["min_providers_per_need", "require_official_for"],
      "properties": {
        "min_providers_per_need": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "require_official_for": { "type": "array", "items": { "type": "string" } }
      }
    },
    "privacy": {
      "type": "object",
      "required": ["synthetic_or_anonymized"],
      "properties": { "synthetic_or_anonymized": { "const": true } }
    }
  }
}
