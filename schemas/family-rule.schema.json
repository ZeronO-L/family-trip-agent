{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-trip-agent.local/schemas/family-rule.schema.json",
  "title": "Family rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_id", "title", "state", "kind", "category", "conditions", "actions", "evidence_case_ids", "confidence", "confirmed_by_user"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "rule_id": { "type": "string" },
    "title": { "type": "string" },
    "state": { "enum": ["case", "candidate", "active", "revised"] },
    "kind": { "enum": ["hard", "soft", "dynamic"] },
    "category": { "enum": ["route", "lodging", "meal", "activity", "weather", "safety", "budget", "privacy", "publishing"] },
    "conditions": { "type": "object" },
    "actions": { "type": "array", "items": { "type": "object" } },
    "evidence_case_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_count": { "type": "integer", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confirmed_by_user": { "type": "boolean" },
    "last_verified_at": { "type": ["string", "null"], "format": "date-time" },
    "supersedes_rule_id": { "type": ["string", "null"] }
  }
}
