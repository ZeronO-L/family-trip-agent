{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-trip-agent.local/schemas/region-validation.schema.json",
  "title": "Regional validation status registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "levels", "regions"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date" },
    "levels": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "enum": ["experimental", "desk_verified", "community_tested", "field_tested"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "label", "status", "evidence_counts", "verified_scope", "limitations", "evidence_refs"],
        "properties": {
          "region_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["experimental", "desk_verified", "community_tested", "field_tested"] },
          "evidence_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_routing_cases", "desk_itinerary_cases", "live_source_records", "community_reports", "field_trips"],
            "properties": {
              "source_routing_cases": { "type": "integer", "minimum": 0 },
              "desk_itinerary_cases": { "type": "integer", "minimum": 0 },
              "live_source_records": { "type": "integer", "minimum": 0 },
              "community_reports": { "type": "integer", "minimum": 0 },
              "field_trips": { "type": "integer", "minimum": 0 }
            }
          },
          "verified_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
