{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-trip-agent.local/schemas/trip.schema.json",
  "title": "Family trip",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trip_id", "family_record_id", "title", "status", "start_date", "end_date", "origin", "destinations", "hard_constraints", "route_options", "plan_versions"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "trip_id": { "type": "string", "minLength": 1 },
    "family_record_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "planning", "locked", "in_progress", "completed", "archived"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "origin": { "type": "string" },
    "destinations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "theme": { "type": "array", "items": { "type": "string" } },
    "locale": { "type": "object" },
    "vehicle": { "type": "object" },
    "budget": { "type": "object" },
    "hard_constraints": { "type": "array", "items": { "type": "object" } },
    "route_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route_id", "city_order", "daily_drive_hours", "selected"],
        "properties": {
          "route_id": { "type": "string" },
          "city_order": { "type": "array", "items": { "type": "string" } },
          "daily_drive_hours": { "type": "array", "items": { "type": "number", "minimum": 0 } },
          "hotel_changes": { "type": "integer", "minimum": 0 },
          "theme_coverage": { "type": "array", "items": { "type": "string" } },
          "selected": { "type": "boolean" },
          "decision_reason": { "type": "string" }
        }
      }
    },
    "selected_route_id": { "type": ["string", "null"] },
    "source_evidence": { "type": "array", "items": { "type": "object" } },
    "plan_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version_id", "created_at", "status", "days"],
        "properties": {
          "version_id": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "status": { "enum": ["draft", "proposed", "accepted", "superseded"] },
          "trigger": { "type": "string" },
          "days": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "actual_events": { "type": "array", "items": { "type": "object" } },
    "expenses": { "type": "array", "items": { "type": "object" } },
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
